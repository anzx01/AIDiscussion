# Connect to Supabase via connection pooling with Supavisor.
DATABASE_URL="postgres://postgres.[PROJECT_REF]:[DATABASE_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations.
DIRECT_URL="postgres://postgres.[PROJECT_REF]:[DATABASE_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# AI providers
USE_MOCK_API="true"
ZHIPU_API_KEY=""
OPENAI_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# Optional third-party image metadata fetcher.
# Keep disabled unless you have confirmed your use complies with the target service terms.
ENABLE_BING_IMAGE_SCRAPER="false"
